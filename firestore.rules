rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deny access to everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Only allow writes to visitors collection
    match /visitorsV2/{visitorId} {
      allow write: if true;
      allow read: if false;
    }
  }
}

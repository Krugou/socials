rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deny access to everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Anonymous page views: create only, fixed fields and bounded sizes
    match /visitorsV2/{visitorId} {
      allow create: if request.resource.data.keys().hasOnly(['timestamp', 'page', 'referrer', 'language'])
        && request.resource.data.timestamp is timestamp
        && request.resource.data.page is string && request.resource.data.page.size() <= 100
        && request.resource.data.referrer is string && request.resource.data.referrer.size() <= 200
        && request.resource.data.language is string && request.resource.data.language.size() <= 10;
      allow read, update, delete: if false;
    }

    // navigation_events and savedgps are not written by the site, so the default rule keeps them locked
  }
}

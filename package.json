{
  "name": "social",
  "version": "0.0.1",
  "scripts": {
    "start": "npm run dev",
    "dev": "vite dev --open --port 3000 --host",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && oxlint .",
    "test": "playwright test",
    "test:install": "playwright install --with-deps chromium",
    "prepare": "husky",
    "export:local": "npm run export --prefix admin && npm run format && git add visitors.json visitors.html DATA_REPORT.md && git commit -m \"chore: update local data export\" && git push"
  },
  "type": "module",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "husky": "^9.1.7",
    "oxlint": "^1.78.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "firebase": "^12.17.1"
  }
}
